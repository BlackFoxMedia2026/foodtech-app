/// Il lavoro che non deve stare dentro una richiesta HTTP.
///
/// L'invio di una campagna contattava il fornitore email una volta per ogni
/// destinatario **dentro** la richiesta del browser: con qualche centinaio di
/// clienti la richiesta scadeva a metà, e nessuno sapeva quali contatti erano
/// stati sincronizzati e quali no. Lo stesso vale per i promemoria.
///
/// Qui il lavoro diventa una riga: chi la crea risponde subito, e il cron la
/// smaltisce a piccoli gruppi, riprovando quelle non riuscite con attese
/// crescenti. Non serve un servizio esterno, non ci sono code in memoria che
/// spariscono al riavvio della funzione.
model BackgroundJob {
  id        String  @id @default(cuid())
  /// Il locale a cui il lavoro appartiene, quando ne ha uno: serve per
  /// mostrarlo nell'interfaccia giusta e per avvisare chi deve saperlo.
  venueId   String?
  /// Che lavoro è: message.send, campaign.send, ...
  kind      String  @db.VarChar(60)
  payload   Json
  /// Due lavori con la stessa chiave non stanno in coda insieme: è così che
  /// due clic sul pulsante «invia» non fanno partire due campagne.
  dedupeKey String? @unique

  /// Quanto conta arrivare prima. Numero piccolo = prima.
  ///
  /// Senza priorità la coda era in ordine di orario, e quattrocento email di
  /// una campagna messe in coda alle 20:00 stavano davanti alla conferma di
  /// una prenotazione arrivata alle 20:01: il cliente aspettava il suo
  /// messaggio dietro una spedizione pubblicitaria. Le due cose hanno urgenze
  /// diverse, e ora l'ordine lo dice (vedi `PRIORITA_PER_TIPO`).
  priority Int @default(100)

  status      BackgroundJobStatus @default(PENDING)
  /// Da quando è eseguibile: adesso per il lavoro immediato, più tardi per
  /// quello programmato o per un nuovo tentativo dopo un errore.
  runAt       DateTime            @default(now())
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(4)
  /// Quante volte il lavoro ha ceduto il turno perché aveva ancora da fare.
  /// Contato a parte dai tentativi: cedere il turno non è un errore, ma un
  /// lavoro che cede per sempre è un lavoro rotto e va fermato.
  yields      Int                 @default(0)
  lastError   String?             @db.VarChar(500)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  venue Venue? @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([status, priority, runAt])
  @@index([venueId, kind, createdAt])
}

enum BackgroundJobStatus {
  PENDING
  RUNNING
  DONE
  /// Tentativi esauriti: resta in tabella, perché un invio non riuscito che
  /// scompare è peggio di uno che resta visibile.
  FAILED
}

// ==========================================================================
// DEM — piani, consumo, invio, dominio
// --------------------------------------------------------------------------
// Il modulo campagne esisteva già (Campaign, Guest, MessageLog, ConsentLog) e
// resta dov'è: qui si aggiunge ciò che mancava per farne un prodotto vendibile
// — quanto si può inviare, quanto è stato inviato, a chi esattamente, com'è
// andata, e da quale dominio si esce.
//
// Una regola attraversa tutte queste tabelle: **ogni riga appartiene a un
// locale**. Non c'è una sola query di questo modulo che possa rispondere senza
// `venueId`, ed è quello che impedisce a un ristorante di leggere le campagne
// di un altro cambiando un identificativo nell'indirizzo.
// ==========================================================================

/// Un piano DEM, così come lo vende Foodtech.
///
/// Sta in tabella e non in una costante perché i prezzi cambiano, e cambiarli
/// in un file significa una pubblicazione per ogni ritocco commerciale. Qui li
/// cambia il Super Admin, e le sottoscrizioni già attive non si toccano da sole
/// (vedi la nota su `stripePriceId`).
model DemPlan {
  id            String            @id @default(cuid())
  /// Il nome stabile su cui il codice può fare affidamento: `incluso`,
  /// `start`, `business`, `pro`, `premium`. Il nome visibile invece si cambia
  /// quando si vuole, ed è `name`.
  slug          String            @unique @db.VarChar(40)
  name          String            @db.VarChar(80)
  /// Quanti destinatari al mese. Non campagne: destinatari.
  monthlyEmails Int
  priceCents    Int               @default(0)
  currency      String            @default("EUR") @db.VarChar(3)
  /// Mensile oggi; annuale è già esprimibile senza toccare lo schema.
  interval      DemPlanInterval   @default(MONTH)
  /// Il prezzo corrispondente su Stripe. Nullo sul piano incluso, che non si
  /// compra.
  ///
  /// Cambiare il prezzo di un piano **non** cambia gli abbonamenti già
  /// attivi: su Stripe un prezzo è immutabile, se ne crea uno nuovo e si
  /// migrano le sottoscrizioni con una procedura esplicita. Scriverlo qui e
  /// sperare non basta, e il Super Admin lo legge scritto accanto al campo.
  stripePriceId String?           @db.VarChar(120)
  active        Boolean           @default(true)
  sortOrder     Int               @default(0)
  description   String?           @db.VarChar(300)
  /// «Più scelto», «Consigliato». Nullo quasi sempre.
  badge         String?           @db.VarChar(40)
  /// I piani `PRIVATE` esistono ma non compaiono nel confronto: è il posto per
  /// un enterprise trattato a mano, senza inventare una seconda tabella.
  visibility    DemPlanVisibility @default(PUBLIC)

  /// Spazio per ciò che verrà — sconti, pacchetti extra, promozioni a tempo —
  /// senza che una colonna vuota per cliente stia in tabella da oggi.
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions DemSubscription[] @relation("DemSubscriptionPlan")
  scheduledFor  DemSubscription[] @relation("DemSubscriptionScheduledPlan")

  @@index([active, sortOrder])
}

enum DemPlanInterval {
  MONTH
  YEAR
}

enum DemPlanVisibility {
  PUBLIC
  PRIVATE
}

/// Il piano di un locale, e lo stato del suo abbonamento.
///
/// Stripe non è la verità: è il modo con cui si incassa. La verità applicativa
/// — quale piano vale adesso, quanto si può inviare, se gli invii sono sospesi
/// — sta qui, perché un webhook che non arriva non deve poter spegnere un
/// prodotto.
model DemSubscription {
  id                   String                @id @default(cuid())
  venueId              String                @unique
  planId               String
  status               DemSubscriptionStatus @default(ACTIVE)
  /// La quota concordata con questo cliente, quando è diversa da quella del
  /// suo piano. Nulla quasi sempre: quando c'è, vince sul piano.
  customMonthlyLimit   Int?
  /// Il piano che entrerà in vigore al prossimo rinnovo.
  ///
  /// È il downgrade: chi passa da Business a Start ha pagato Business fino a
  /// fine periodo e Business deve restare acceso fino a lì. Togliergli la
  /// quota il giorno del clic sarebbe vendergli un mese e dargliene mezzo.
  scheduledPlanId      String?
  scheduledChangeAt    DateTime?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean               @default(false)
  stripeCustomerId     String?               @db.VarChar(120)
  stripeSubscriptionId String?               @unique @db.VarChar(120)
  stripePriceId        String?               @db.VarChar(120)
  /// Invii fermi: o l'abbiamo deciso noi per proteggere la reputazione, o li
  /// ha fermati il fornitore. In entrambi i casi non si cancella niente —
  /// campagne, contatti e statistiche restano — si smette solo di inviare.
  sendingPausedAt      DateTime?
  sendingPausedReason  String?               @db.VarChar(200)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  venue         Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  plan          DemPlan  @relation("DemSubscriptionPlan", fields: [planId], references: [id])
  scheduledPlan DemPlan? @relation("DemSubscriptionScheduledPlan", fields: [scheduledPlanId], references: [id])

  @@index([status, currentPeriodEnd])
}

enum DemSubscriptionStatus {
  ACTIVE
  /// Pagamento non riuscito: il piano resta, l'invio continua entro il periodo
  /// già pagato, e al cliente lo si dice.
  PAST_DUE
  CANCELLED
  /// Checkout aperto e non concluso: non dà diritto a niente.
  INCOMPLETE
}

/// Quanto è stato inviato in un mese, e quanto era il limite in quel mese.
///
/// Una riga per locale e per ciclo, e le righe vecchie **non si cancellano**:
/// «settembre 32.480, agosto 28.920» è una domanda che un cliente fa, e un
/// contatore azzerato al rinnovo non sa rispondere.
///
/// `monthlyLimit` è congelato nella riga e non letto dal piano: se a ottobre il
/// prezzo di Business cambia, settembre deve continuare a dire quale limite
/// aveva settembre.
model DemUsagePeriod {
  id           String   @id @default(cuid())
  venueId      String
  /// `2026-09`, come già fa AgentUsage: ordinabile come stringa, leggibile a
  /// occhio in una query fatta a mano.
  yearMonth    String   @db.VarChar(7)
  periodStart  DateTime
  periodEnd    DateTime
  monthlyLimit Int
  planSlug     String   @db.VarChar(40)
  /// Invii già entrati nel processo di invio verso il fornitore.
  used         Int      @default(0)
  /// Invii impegnati da campagne programmate o in corso, non ancora partiti.
  ///
  /// Senza questa colonna due schede aperte insieme programmano due campagne
  /// da ottomila invii su diecimila disponibili, e partono entrambe: il
  /// controllo «ce n'è abbastanza?» sarebbe vero per tutte e due nello stesso
  /// istante. Disponibili = limite − usati − riservati.
  reserved     Int      @default(0)
  /// Le soglie di avviso già comunicate in questo ciclo (80, 95, 100).
  /// Un avviso che si ripete a ogni invio smette di essere un avviso.
  notified     Int[]    @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, yearMonth])
  @@index([venueId, periodStart])
}

/// Un destinatario di una campagna, congelato prima della partenza.
///
/// È la fotografia di §3: chi riceve davvero questa email. Si costruisce una
/// volta, prima di riservare la quota, ed è quella che si paga — non il
/// segmento, che intanto può cambiare.
///
/// L'unicità su `[campaignId, email]` è il deduplicatore: due contatti con lo
/// stesso indirizzo dentro lo stesso segmento sono una email sola, e un invio
/// solo da scalare.
model CampaignRecipient {
  id                String                  @id @default(cuid())
  campaignId        String
  venueId           String
  guestId           String?
  email             String                  @db.VarChar(320)
  /// I dati personali al momento dello scatto: servono a comporre l'email
  /// anche se nel frattempo la scheda cliente cambia o viene anonimizzata.
  firstName         String?                 @db.VarChar(120)
  lastName          String?                 @db.VarChar(120)
  vars              Json?
  status            CampaignRecipientStatus @default(PENDING)
  /// L'identificativo che il fornitore restituisce accettando il messaggio: è
  /// il filo che lega questa riga agli eventi che arriveranno dopo.
  providerMessageId String?                 @db.VarChar(200)
  queuedAt          DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  complainedAt      DateTime?
  unsubscribedAt    DateTime?
  failedAt          DateTime?
  /// Quante volte, non solo se: l'interfaccia mostra «aperta», ma una metrica
  /// corretta ha bisogno del conteggio.
  openCount         Int                     @default(0)
  clickCount        Int                     @default(0)
  error             String?                 @db.VarChar(300)
  createdAt         DateTime                @default(now())

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  venue    Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  guest    Guest?          @relation(fields: [guestId], references: [id], onDelete: SetNull)
  events   CampaignEvent[]

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([venueId, createdAt])
  @@index([providerMessageId])
}

enum CampaignRecipientStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
  /// Escluso prima di partire: disiscritto, soppresso o senza consenso al
  /// momento del controllo finale. Non è un errore, e non costa quota.
  SKIPPED
}

/// Un evento del fornitore, salvato una volta sola.
///
/// Amazon consegna lo stesso evento più volte: è dichiarato, non è un guasto.
/// Se le statistiche si incrementassero a ogni consegna, un'apertura
/// riconsegnata tre volte diventerebbe tre aperture. `providerEventId` unico è
/// il modo più economico di rendere l'operazione ripetibile: la seconda
/// scrittura sbatte contro il vincolo e non succede niente.
model CampaignEvent {
  id              String       @id @default(cuid())
  venueId         String
  campaignId      String
  recipientId     String?
  type            DemEventType
  providerEventId String       @unique @db.VarChar(250)
  occurredAt      DateTime
  /// Per i click: dove si è andati.
  url             String?      @db.VarChar(600)
  /// Il sottotipo tecnico — `Permanent/General`, `abuse` — che al cliente non
  /// si mostra e all'assistenza serve.
  detail          String?      @db.VarChar(300)
  createdAt       DateTime     @default(now())

  venue     Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  campaign  Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient CampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([campaignId, type])
  @@index([venueId, occurredAt])
  @@index([recipientId, type])
}

enum DemEventType {
  SEND
  DELIVERY
  OPEN
  CLICK
  BOUNCE
  COMPLAINT
  DELIVERY_DELAY
  REJECT
  SUBSCRIPTION
  RENDERING_FAILURE
}

/// Gli indirizzi a cui questo locale non scrive più.
///
/// Separata dal consenso di proposito. `Guest.marketingOptIn` è una scelta del
/// cliente finale; questa tabella è anche il rifiuto tecnico — un indirizzo che
/// non esiste, una segnalazione di spam — e vale per un indirizzo, non per una
/// scheda: la stessa email può stare su due schede doppione, e deve restare
/// soppressa su entrambe.
///
/// È per locale: un indirizzo che rimbalza per il Ristorante A non è un
/// problema del Ristorante B, e sopprimerlo per tutti significherebbe far
/// pagare a un cliente la lista sporca di un altro.
model DemSuppression {
  id        String               @id @default(cuid())
  venueId   String
  email     String               @db.VarChar(320)
  reason    DemSuppressionReason
  detail    String?              @db.VarChar(300)
  /// Chi l'ha messo qui: `ses_bounce`, `unsubscribe_link`, `import`, `manuale`.
  source    String?              @db.VarChar(60)
  createdAt DateTime             @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, email])
  @@index([venueId, reason])
}

enum DemSuppressionReason {
  HARD_BOUNCE
  COMPLAINT
  UNSUBSCRIBE
  MANUAL
  INVALID
}

/// Il dominio da cui escono le newsletter di un locale.
///
/// Non il dominio principale del cliente: un **sottodominio** dedicato. Il sito
/// e la posta aziendale restano dove sono e non si toccano — cambiare gli MX di
/// `ristorante.it` per mandare una newsletter significa poter spegnere la
/// casella su cui quel ristorante riceve le prenotazioni.
model DemDomain {
  id             String          @id @default(cuid())
  venueId        String          @unique
  /// `ristorante.it` — serve solo per proporre il sottodominio e per leggere
  /// il DMARC, che si pubblica sul dominio organizzativo.
  rootDomain     String          @db.VarChar(253)
  /// `news.ristorante.it` — il dominio del mittente.
  sendingDomain  String          @unique @db.VarChar(253)
  /// `bounce.news.ristorante.it` — il Return-Path.
  ///
  /// Sottodominio **suo**, distinto da quello del mittente: il custom MAIL
  /// FROM richiede un record MX, e metterlo sullo stesso nome che un domani
  /// potrebbe ricevere posta è il modo di rompere le due cose insieme.
  mailFromDomain String?         @db.VarChar(253)
  /// La parte prima della chiocciola: `newsletter@news.ristorante.it`.
  fromLocalPart  String          @default("newsletter") @db.VarChar(64)
  fromName       String?         @db.VarChar(120)
  /// Dove finiscono le risposte. Separato dal mittente perché nessuno legge
  /// una casella che serve solo a spedire, e un cliente che risponde a una
  /// newsletter si aspetta che qualcuno la legga.
  replyTo        String?         @db.VarChar(320)
  status         DemDomainStatus @default(PENDING)
  dkimStatus     DemRecordStatus @default(UNKNOWN)
  spfStatus      DemRecordStatus @default(UNKNOWN)
  dmarcStatus    DemRecordStatus @default(UNKNOWN)
  /// La politica DMARC trovata sul dominio, se c'è. Non la scriviamo noi: il
  /// cliente potrebbe avere già altri servizi che spediscono per suo conto, e
  /// sovrascrivere il suo DMARC significherebbe farglieli rifiutare.
  dmarcPolicy    String?         @db.VarChar(30)
  /// I record da configurare, come li ha generati il fornitore. Json e non
  /// colonne: sono tre CNAME oggi, potrebbero essere altro domani, e
  /// l'interfaccia li mostra in tabella senza doverli conoscere.
  dnsRecords     Json?
  lastCheckedAt  DateTime?
  verifiedAt     DateTime?
  /// L'errore tecnico per l'assistenza. Al cliente si dice un'altra cosa.
  lastError      String?         @db.VarChar(400)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum DemDomainStatus {
  PENDING
  VERIFYING
  VERIFIED
  FAILED
}

enum DemRecordStatus {
  UNKNOWN
  PENDING
  OK
  MISSING
  FAILED
}

/// Lo spazio isolato del locale presso il fornitore di invio.
///
/// Sta in una tabella sua e non dentro `DemDomain` perché le due cose hanno
/// vite diverse: un cliente può cambiare dominio di invio, e il suo spazio —
/// con dentro la lista dei soppressi e la storia della sua reputazione — non
/// deve nascere di nuovo da zero.
///
/// Il nome è prevedibile e ricavato dall'identificativo del locale, perché
/// ritrovarlo non deve dipendere da una riga scritta bene.
model DemSesTenant {
  id               String          @id @default(cuid())
  venueId          String          @unique
  tenantName       String          @unique @db.VarChar(64)
  configurationSet String          @unique @db.VarChar(64)
  status           DemTenantStatus @default(ACTIVE)
  /// Percentuali calcolate all'ultimo controllo: servono all'elenco del Super
  /// Admin, che altrimenti dovrebbe contare gli eventi di ogni cliente per
  /// disegnare una riga.
  bounceRate       Float?
  complaintRate    Float?
  lastCheckedAt    DateTime?
  pausedAt         DateTime?
  pausedReason     String?         @db.VarChar(200)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum DemTenantStatus {
  ACTIVE
  /// Fermato da noi o dal fornitore. Non cancella niente.
  PAUSED
  FAILED
}

model Booking {
  id                String             @id @default(cuid())
  reference         String             @unique @default(cuid())
  venueId           String
  guestId           String?
  tableId           String?
  partySize         Int
  startsAt          DateTime
  durationMin       Int                @default(105)
  status            BookingStatus      @default(CONFIRMED)
  source            BookingSource      @default(WIDGET)
  occasion          Occasion?
  notes             String?
  internalNotes     String?
  depositCents      Int                @default(0)
  depositStatus     DepositStatus      @default(NONE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  arrivedAt         DateTime?
  seatedAt          DateTime?
  closedAt          DateTime?
  budgetCents       Int?
  eventType         String?            @db.VarChar(60)
  isGroup           Boolean            @default(false)
  combinedTableIds  String[]           @default([])
  deletedAt         DateTime?
  deletedBy         String?
  /// La campagna da cui arriva questa prenotazione, quando arriva da una.
  ///
  /// Si valorizza solo dal widget pubblico, quando il link cliccato porta con
  /// sé la campagna, e **dopo** aver verificato che quella campagna sia di
  /// questo locale: senza il controllo, chi conosce un identificativo
  /// potrebbe attribuire prenotazioni alle campagne di altri.
  ///
  /// Serve per rispondere a «quante prenotazioni ha portato quell'email».
  /// Prima c'era `Campaign.bookedCount`, che nessuno scriveva e che mostrava
  /// zero su ogni campagna.
  campaignId        String?
  /// La chiave che il widget genera per **un** tentativo di prenotazione.
  ///
  /// Serve a una cosa sola: un cliente che tocca «Prenota» due volte sulla
  /// rete del ristorante deve prenotare una volta. Alla seconda chiamata con
  /// la stessa chiave si restituisce la prenotazione già creata invece di
  /// farne un'altra — e l'unicità la garantisce il database, non un controllo
  /// che due richieste in parallelo si scambierebbero senza vedersi.
  idempotencyKey    String?            @unique
  Campaign          Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  orders            Order[]
  comande           Comanda[]
  guest             Guest?             @relation(fields: [guestId], references: [id])
  table             Table?             @relation(fields: [tableId], references: [id])
  venue             Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  BookingEvent      BookingEvent[]
  BookingPreorder   BookingPreorder?
  payments          Payment[]
  VoiceBookingDraft VoiceBookingDraft?
  messages          MessageLog[]
  Survey            Survey?

  @@index([venueId, startsAt])
  @@index([venueId, status])
  @@index([venueId, deletedAt])
  @@index([campaignId])
}


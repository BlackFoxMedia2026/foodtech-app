model Order {
  id               String              @id @default(cuid())
  reference        String              @unique
  venueId          String
  guestId          String?
  /// La prenotazione a cui questo conto appartiene, quando è un conto al
  /// tavolo. Mancava: c'era solo `tableLabel`, una stringa, quindi il conto
  /// non si poteva ricondurre alla serata di nessuno — e sono i coperti di
  /// una prenotazione a trasformare un totale in un incasso attribuibile.
  bookingId        String?
  kind             OrderKind           @default(TAKEAWAY)
  status           OrderStatus         @default(RECEIVED)
  paymentStatus    PaymentStatus       @default(PENDING)
  /// Obbligatori per l'asporto e la consegna, senza senso per un conto al
  /// tavolo: lì il cliente è la prenotazione. Erano `NOT NULL`, e l'unico modo
  /// di aprire un conto al tavolo sarebbe stato inventare un nome e un
  /// telefono — cioè scrivere dati finti, che è quello che questo progetto
  /// passa il tempo a togliere.
  customerName     String?
  phone            String?
  email            String?
  address          String?
  scheduledAt      DateTime
  totalCents       Int                 @default(0)
  currency         String              @default("EUR")
  notes            String?
  stripeId         String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  preparedAt       DateTime?
  readyAt          DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  tableLabel       String?             @db.VarChar(40)
  /// Quando il tavolo ha **chiesto** il conto.
  ///
  /// Finora «al conto» era un'ipotesi: la sala lo deduceva dal fatto che la
  /// seduta avesse superato la durata prevista (`deriveTableLiveStatus`). È
  /// una stima utile e resta, ma non è la stessa cosa — un tavolo può stare
  /// due ore e non aver chiesto niente, e un altro chiedere il conto dopo
  /// quaranta minuti. Questo è il fatto: qualcuno l'ha chiesto, a
  /// quest'ora. Nullo su tutto lo storico, ed è corretto — di quei tavoli
  /// non lo sapevamo.
  contoRichiestoAt DateTime?
  Guest            Guest?              @relation(fields: [guestId], references: [id])
  Venue            Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  booking          Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  OrderItem        OrderItem[]
  comande          Comanda[]
  ospiti           OrderGuest[]
  payments         Payment[]
  allocations      PaymentAllocation[]

  @@index([venueId, createdAt])
  @@index([venueId, status, scheduledAt])
  @@index([bookingId])
}

model OrderItem {
  id           String              @id @default(cuid())
  orderId      String
  menuItemId   String?
  name         String
  priceCents   Int
  quantity     Int                 @default(1)
  notes        String?
  /// La tranche con cui questa riga va (o è andata) in cucina.
  ///
  /// **Nullo** sulle righe battute dal back office, che sono voci di conto e
  /// non sono mai passate da una comanda: l'app di sala le legge sempre
  /// filtrando su questo campo, così le due strade non si mescolano.
  comandaId    String?
  /// A chi va servito questo piatto. Nullo = «tutto il tavolo».
  orderGuestId String?
  /// Lo stato della **singola riga**, che non è quello della comanda: la
  /// cucina manda fuori un piatto alla volta, e «due piatti pronti su
  /// quattro» è la frase che serve al cameriere. Ha senso solo con
  /// `comandaId` valorizzato.
  status       ComandaRigaStatus   @default(BOZZA)
  /// Gli allergeni **dichiarati dall'ospite per questa riga**, che sono una
  /// cosa diversa da `MenuItem.allergens` (cosa c'è dentro il piatto). Qui
  /// sta «questa persona è allergica», e va stampato in cucina in grande.
  allergens    String[]            @default([])
  allergyNote  String?             @db.VarChar(300)
  sentAt       DateTime?
  readyAt      DateTime?
  servedAt     DateTime?
  MenuItem     MenuItem?           @relation(fields: [menuItemId], references: [id])
  Order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  comanda      Comanda?            @relation(fields: [comandaId], references: [id], onDelete: SetNull)
  ospite       OrderGuest?         @relation(fields: [orderGuestId], references: [id], onDelete: SetNull)
  modifiche    OrderItemModifica[]
  allocations  PaymentAllocation[]

  @@index([orderId])
  @@index([comandaId])
  @@index([orderGuestId])
}

// ========================================================================== //
//  La comanda                                                                //
// ========================================================================== //

/// **Una tranche di piatti mandata in cucina.**
///
/// Non è un `Order`, ed è la distinzione che regge tutto il modulo. `Order` è
/// il **conto** del tavolo: apre quando le persone si siedono, chiude quando
/// pagano, e ne esiste **uno** per serata. La comanda è quello che si manda
/// alla brigata, e in una serata ne partono quattro o cinque dallo stesso
/// tavolo — prima le bevande, poi gli antipasti, poi i secondi, poi i dolci.
///
/// Modellarla come un secondo `Order` avrebbe spezzato il conto in cinque
/// pezzi, e il tavolo 12 a fine serata avrebbe avuto cinque totali. Qui la
/// comanda sta **dentro** il conto: `Order` resta l'unico posto in cui si
/// legge quanto deve il tavolo, e `Comanda` risponde a «cosa è già partito e a
/// che punto è».
///
/// ## Il §22 del brief in una riga
///
/// «NON considerare una comanda come qualcosa che blocca il tavolo dopo il
/// primo invio»: è vero per costruzione, perché la relazione è uno-a-molti e
/// una comanda inviata non impedisce di aprirne un'altra in bozza.
///
/// ## Perché `invioKey`
///
/// Un cameriere che tocca due volte «Invia in cucina» su una rete che arranca
/// deve mandare **una** comanda. Il client genera una chiave per tentativo, e
/// l'unicità la garantisce il database — non un controllo applicativo, che due
/// richieste in parallelo si scambierebbero senza vedersi. Stessa difesa che
/// `Booking.idempotencyKey` fa per il widget pubblico.
model Comanda {
  id             String           @id @default(cuid())
  venueId        String
  /// Il conto a cui questa tranche appartiene. Obbligatorio: una comanda
  /// senza conto è cibo che esce dalla cucina e non finisce su nessun totale.
  orderId        String
  tableId        String?
  bookingId      String?
  /// Chi l'ha battuta. Nullo solo se l'anagrafica viene cancellata dopo: la
  /// comanda resta, perché è un fatto successo.
  waiterId       String?
  /// Progressivo **dentro il conto**: la prima, la seconda, la terza. Non è
  /// un identificativo globale — quello è `id` — è il numero che il cameriere
  /// legge nello storico del tavolo.
  numero         Int
  status         ComandaStatus    @default(BOZZA)
  /// Chi ha preso in carico questa comanda. Oggi sempre `INTERNO`: la coda di
  /// cucina di Tavolo. Esiste da subito perché il giorno in cui una comanda
  /// parte verso un POS esterno bisogna poter rispondere a «questa dov'è
  /// andata», e aggiungere la colonna dopo vorrebbe dire non saperlo per
  /// tutto lo storico precedente.
  fornitore      FornitoreComanda @default(INTERNO)
  /// L'identificativo che il fornitore esterno ci restituisce, quando ce n'è
  /// uno. Sempre nullo finché il fornitore è quello interno.
  fornitoreRef   String?          @db.VarChar(120)
  /// Una nota per la cucina, valida per tutta la tranche.
  nota           String?          @db.VarChar(500)
  /// La chiave del **tentativo di invio**: due tap sullo stesso pulsante
  /// portano la stessa chiave, e il secondo trova la comanda già inviata.
  invioKey       String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sentAt         DateTime?
  acknowledgedAt DateTime?
  preparingAt    DateTime?
  readyAt        DateTime?
  servedAt       DateTime?
  cancelledAt    DateTime?
  venue          Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  table          Table?           @relation(fields: [tableId], references: [id], onDelete: SetNull)
  booking        Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  waiter         Waiter?          @relation(fields: [waiterId], references: [id], onDelete: SetNull)
  righe          OrderItem[]
  eventi         ComandaEvento[]

  @@unique([orderId, numero])
  @@index([venueId, status, sentAt])
  @@index([venueId, createdAt])
  @@index([tableId, createdAt])
  @@index([waiterId, createdAt])
}

/// Lo storico degli stati di una comanda: **chi** l'ha mossa e **quando**.
///
/// Le colonne `sentAt`/`readyAt`/... su `Comanda` rispondono a «quando è
/// successo» e bastano a disegnare una schermata. Non rispondono a «chi» e
/// non reggono i passaggi che si ripetono — una comanda modificata torna in
/// preparazione una seconda volta, e quella seconda volta sovrascriverebbe la
/// prima. Il §42 del brief chiede di sapere sempre chi ha fatto cosa: è qui.
model ComandaEvento {
  id        String         @id @default(cuid())
  comandaId String
  /// Nullo sul primo evento: prima della bozza non c'era niente.
  da        ComandaStatus?
  a         ComandaStatus
  at        DateTime       @default(now())
  /// La persona dell'organico che ha mosso la comanda, quando è una persona.
  waiterId  String?
  /// L'account, per i casi in cui non c'è un'anagrafica dietro (un manager
  /// che chiude una comanda dal back office).
  userId    String?
  nota      String?        @db.VarChar(300)
  comanda   Comanda        @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  waiter    Waiter?        @relation(fields: [waiterId], references: [id], onDelete: SetNull)

  @@index([comandaId, at])
}

/// **Un commensale**, per dividere piatti e conto.
///
/// Si creano automaticamente all'apertura del tavolo, uno per coperto, con un
/// nome provvisorio («Ospite 1»). Il cameriere può rinominarli: «Marco»,
/// «Laura». Non sono `Guest` del CRM e non devono diventarlo — un commensale
/// è una posizione a tavola per una sera, un `Guest` è una persona con una
/// storia, un telefono e un consenso. Confonderli riempirebbe il CRM di
/// «Ospite 3».
model OrderGuest {
  id        String      @id @default(cuid())
  orderId   String
  /// La posizione: 1, 2, 3... Regge l'ordinamento e il nome per difetto.
  ordering  Int
  label     String      @db.VarChar(60)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  righe     OrderItem[]

  @@unique([orderId, ordering])
  @@index([orderId])
}

/// **Una variazione su una riga di comanda**: cottura, senza, extra, porzione.
///
/// Righe e non colonne su `OrderItem`, per due motivi. Il primo: sono un
/// numero variabile — «al sangue, senza sale, extra patate» sono tre, e tre
/// colonne non basterebbero comunque. Il secondo: l'extra ha un **prezzo**, e
/// un prezzo che va sul conto deve poter stare su una riga sua, non dentro una
/// stringa da riparsare.
///
/// `priceCents` è un **delta**, quasi sempre zero: una cottura non costa, una
/// salsa in più sì. Non si somma al totale leggendo queste righe: il delta
/// viene **già incorporato** in `OrderItem.priceCents` quando la riga si
/// salva, ed è deliberato — così ogni conto già scritto (totale del conto,
/// food cost, quote di un conto diviso) continua a tornare senza che nessuno
/// debba sapere che esistono i modificatori. Qui il delta resta per poterlo
/// **mostrare** separato: «Tagliata 24,00 + salsa 2,00».
model OrderItemModifica {
  id          String              @id @default(cuid())
  orderItemId String
  kind        ComandaModificaKind
  /// Cosa c'è scritto sul foglio della cucina: «Al sangue», «Senza pecorino»,
  /// «Extra patate». Testo libero e non un catalogo, perché ogni cucina ha il
  /// suo — i suggerimenti stanno in `lib/personalizzazioni.ts`.
  label       String              @db.VarChar(80)
  priceCents  Int                 @default(0)
  ordering    Int                 @default(0)
  item        OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

/// Gli stati di una comanda, nell'ordine in cui si attraversano.
///
/// `RICEVUTA` esiste separata da `INVIATA` e non è un doppione: «è partita» lo
/// sa la sala, «è arrivata a qualcuno» lo dice la cucina. Chi ha appena
/// premuto invia su una rete incerta ha bisogno di vedere la seconda, non la
/// prima.
enum ComandaStatus {
  BOZZA
  INVIATA
  RICEVUTA
  IN_PREPARAZIONE
  PRONTA
  SERVITA
  ANNULLATA
}

/// Lo stato di una **riga**. Gli stessi nomi della comanda meno `RICEVUTA`:
/// la presa in carico riguarda il foglio intero, il singolo piatto no.
enum ComandaRigaStatus {
  BOZZA
  INVIATA
  IN_PREPARAZIONE
  PRONTA
  SERVITA
  ANNULLATA
}

enum ComandaModificaKind {
  /// Una scelta fra alternative previste: «Impasto integrale».
  VARIANTE
  /// Un ingrediente tolto: «Senza pecorino».
  SENZA
  /// Un'aggiunta, spesso a pagamento: «Extra patate».
  EXTRA
  /// «Al sangue», «Ben cotta».
  COTTURA
  /// «Porzione piccola», «Mezza porzione».
  PORZIONE
}

/// Chi prende in carico la comanda.
///
/// Oggi **un solo valore**, e va detto perché: il §44 del brief vieta di
/// simulare integrazioni che non abbiamo. Qui non c'è nessun collegamento
/// finto — c'è una colonna che oggi vale sempre `INTERNO` e un'interfaccia
/// (`server/comande/fornitore.ts`) con una sola implementazione. Il giorno in
/// cui arriva Lightspeed si aggiunge un valore qui e una classe là, e
/// l'interfaccia della sala non cambia di una riga.
enum FornitoreComanda {
  INTERNO
}

model POSConnector {
  id            String             @id @default(cuid())
  venueId       String
  kind          POSConnectorKind
  label         String?
  status        POSConnectorStatus @default(DRAFT)
  config        Json?
  webhookSecret String?
  externalRef   String?
  lastSyncAt    DateTime?
  lastError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  Venue         Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  POSEvent      POSEvent[]

  @@unique([venueId, kind])
  @@index([venueId, status])
}

model POSEvent {
  id             String         @id @default(cuid())
  posConnectorId String
  venueId        String
  externalRef    String?
  action         String
  amountCents    Int            @default(0)
  currency       String         @default("EUR")
  payload        Json?
  status         POSEventStatus @default(RECEIVED)
  orderId        String?
  error          String?
  createdAt      DateTime       @default(now())
  POSConnector   POSConnector   @relation(fields: [posConnectorId], references: [id], onDelete: Cascade)

  @@index([posConnectorId, createdAt])
  @@index([venueId, createdAt])
}

model Review {
  id           String       @id @default(cuid())
  venueId      String
  source       ReviewSource
  externalRef  String?
  externalUrl  String?
  rating       Int
  authorName   String?      @db.VarChar(120)
  authorAvatar String?
  text         String?      @db.VarChar(2000)
  language     String       @default("it")
  publishedAt  DateTime?
  fetchedAt    DateTime     @default(now())
  createdAt    DateTime     @default(now())
  Venue        Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, source, externalRef])
  @@index([venueId, publishedAt])
}

model ReviewLink {
  id              String            @id @default(cuid())
  venueId         String
  platform        ReviewPlatform
  label           String?
  url             String
  ordering        Int               @default(0)
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  Venue           Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  ReviewLinkClick ReviewLinkClick[]

  @@index([venueId, active, ordering])
}

model ReviewLinkClick {
  id         String     @id @default(cuid())
  linkId     String
  venueId    String
  surveyId   String?
  npsScore   Int?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())
  ReviewLink ReviewLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  Venue      Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
  @@index([venueId, createdAt])
}

// Una persona in organico. Il nome del modello e' rimasto `Waiter` per non
// riscrivere quindici relazioni e una migrazione distruttiva, ma il dominio e'
// cambiato: qui dentro ci stanno anche l'executive chef e il lavapiatti. Nel
// prodotto si chiama **Staff**, e cosi' si chiama ovunque nell'interfaccia.
model Waiter {
  id                    String              @id @default(cuid())
  venueId               String
  firstName             String
  lastName              String
  birthday              DateTime
  phone                 String
  email                 String?
  /// Testo libero, storico. Oggi lo scrive `resolveRole()` a partire da
  /// `primaryRole`: nessuna schermata lo fa piu' digitare. Resta perche' le
  /// anagrafiche create prima dell'enum hanno qui l'unico ruolo che esiste.
  role                  String
  primaryRole           StaffPrimaryRole?
  /// Override del reparto. **Quasi sempre nullo**: il reparto si deriva dal
  /// ruolo (`ROLE_DEPARTMENT` in src/lib/staff-roles.ts), una fonte sola.
  /// Esiste per i ruoli custom futuri, che avranno un reparto ma non un
  /// valore d'enum — non per correggere a mano il reparto di un maitre.
  department            StaffDepartment?
  capabilities          StaffCapability[]   @default([])
  status                WaiterStatus        @default(ACTIVE)
  hireDate              DateTime?
  photoUrl              String?
  /// L'anagrafica completa, come la chiede una scheda HR: tutto nullabile,
  /// perché le persone in organico oggi hanno solo nome, nascita e telefono
  /// e la scheda deve restare valida anche vuota.
  fiscalCode            String?             @db.VarChar(32)
  birthPlace            String?             @db.VarChar(120)
  nationality           String?             @db.VarChar(80)
  address               String?             @db.VarChar(200)
  postalCode            String?             @db.VarChar(16)
  city                  String?             @db.VarChar(120)
  province              String?             @db.VarChar(8)
  emergencyContactName  String?             @db.VarChar(120)
  emergencyContactPhone String?             @db.VarChar(40)
  /// Le caratteristiche: «Sommelier», «Inglese», «Apertura locale», «Auto
  /// propria». Testo libero e non enum, perché ogni locale ne inventa le sue;
  /// i suggerimenti stanno in lib/scheda-dipendente.ts. Diverse dalle
  /// `capabilities`, che dicono a cosa si può essere **assegnati** in sala.
  skills                String[]            @default([])
  /// Il responsabile diretto, quando è una persona dell'organico.
  managerId             String?
  /// L'account con cui questa persona entra in Tavolo, quando ne ha uno.
  /// Serve alla vista dipendente: e' il ponte fra «Mario Rossi, cameriere»
  /// e «chi sta guardando questo schermo». Cancellare l'account non cancella
  /// la persona dall'organico, quindi SetNull e non Cascade.
  userId                String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  venue                 Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments           WaiterAssignment[]
  staffAssignments      StaffAssignment[]
  contracts             StaffContract[]
  shifts                WorkShift[]
  requests              StaffRequest[]
  manager               Waiter?             @relation("StaffManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports               Waiter[]            @relation("StaffManager")
  documents             StaffDocument[]
  trainings             StaffTraining[]
  medicalChecks         StaffMedicalCheck[]
  notes                 StaffNote[]
  comande               Comanda[]
  comandaEventi         ComandaEvento[]
  notifiche             Notification[]

  @@unique([venueId, userId])
  @@index([venueId, createdAt])
  @@index([venueId, status])
}

// Dove lavora una persona, non cosa fa. Distinto da StaffPrimaryRole perche'
// e' l'unica cosa che tiene leggibile l'elenco: con sedici ruoli in fila si
// legge riga per riga, con quattro reparti l'occhio salta al punto giusto.
//
// ALTRO **non e' il cestino dei ruoli nuovi**: ogni ruolo che arriva prende il
// suo reparto (un bar manager va in BAR, un addetto delivery portera' con se'
// il suo reparto). ALTRO raccoglie solo le anagrafiche storiche senza
// `primaryRole`, che hanno il ruolo scritto a mano e nient'altro.
enum StaffDepartment {
  SALA
  CUCINA
  BAR
  DIREZIONE
  ALTRO
}

// Disponibilita' della persona, non il suo turno di oggi. Il turno sta in
// WorkShift ed e' datato; questo e' lo stato corrente del profilo, quello che
// risponde a «posso metterlo in squadra domani?».
enum WaiterStatus {
  ACTIVE
  RESTING
  VACATION
  SICK_LEAVE
  UNAVAILABLE
}

// Employment contract for a Waiter. One-to-many on purpose (brief section 22):
// a worker moves through renewals over time (contract 1 expires, contract 2
// renews it, ...) and the roster must keep that history, not just the latest
// end date. "Current" contract is picked at query time (see
// src/lib/staff-contracts.ts), never stored — status/label included.
model StaffContract {
  id               String                  @id @default(cuid())
  venueId          String
  waiterId         String
  contractType     StaffContractType
  startDate        DateTime
  endDate          DateTime?
  weeklyHours      Float?
  contractualRole  String?
  /// Livello o inquadramento («4° livello CCNL Turismo»): testo, perché i
  /// contratti collettivi sono decine e ogni locale scrive il suo.
  level            String?                 @db.VarChar(120)
  /// I giorni della settimana previsti dal contratto, come `Shift.weekday`:
  /// 0 = domenica. Vuoto = non specificato.
  workingDays      Int[]                   @default([])
  /// Fine del periodo di prova, quando c'è.
  probationEndDate DateTime?
  notes            String?                 @db.VarChar(2000)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  venue            Venue                   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  waiter           Waiter                  @relation(fields: [waiterId], references: [id], onDelete: Cascade)
  reminders        StaffContractReminder[]
  document         ContractDocument?

  @@index([venueId, waiterId, startDate])
  @@index([venueId, endDate])
}

// The digital copy attached to one specific contract (not to the waiter
// profile) — a renewal gets its own row/document, the old one keeps its own
// (brief: "Staff -> Contratto A -> Documento A, Contratto B -> Documento B").
// One document per contract in V1 (contractId is unique); storageKey is an
// internal Vercel Blob pathname, never a public URL — access is always
// mediated by /api/waiters/[id]/contracts/[contractId]/document, which
// checks session + tenant + contract ownership + the manage_contracts
// ability before streaming the blob (brief sections 16/19).
model ContractDocument {
  id               String        @id @default(cuid())
  venueId          String
  contractId       String        @unique
  storageKey       String
  originalFileName String
  mimeType         String
  fileSize         Int
  uploadedBy       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  venue            Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  contract         StaffContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

enum StaffContractType {
  TEMPO_DETERMINATO
  TEMPO_INDETERMINATO
  PART_TIME
  FULL_TIME
  STAGIONALE
  APPRENDISTATO
  COLLABORAZIONE
  A_CHIAMATA
  STAGE
  ALTRO
}

// Tracks which expiry reminder thresholds have already fired for a contract,
// so the daily cron (brief sections 13/41) never re-notifies the same
// threshold twice. (contractId, reminderType) is the dedupe key.
model StaffContractReminder {
  id           String                    @id @default(cuid())
  contractId   String
  reminderType StaffContractReminderType
  sentAt       DateTime                  @default(now())
  contract     StaffContract             @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, reminderType])
}

enum StaffContractReminderType {
  DAYS_30
  DAYS_15
  DAYS_7
  DUE_TODAY
  EXPIRED
}

// ---------------------------------------------------------------------------
// La scheda HR del dipendente (settembre 2026).
//
// Quattro tabelle nuove e nessuna che duplichi una cosa che c'era già:
//
//   StaffDocument      = un file della persona (carta d'identità, permesso di
//                        soggiorno, busta paga, attestato...). Il documento
//                        del **contratto** resta in ContractDocument, perché
//                        appartiene a un contratto e non alla persona.
//   StaffTraining      = un corso o adempimento (sicurezza, HACCP, antincendio,
//                        primo soccorso), con la sua scadenza e l'attestato.
//   StaffMedicalCheck  = una visita del medico competente, con l'idoneità.
//   StaffNote          = una nota interna, che il dipendente non vede.
//
// Le **caratteristiche** sono `Waiter.skills`; lo **storico** è `AuditLog`
// (entityType "waiter", entityId = la persona), che si scriveva già; i
// **permessi** sono `VenueMembership.permissions`. Tre cose che esistevano
// e che qui si leggono, non si rifanno.
//
// Attestati e certificati sono righe di StaffDocument collegate: così la tab
// «Documenti» li mostra tutti, e un file sta in un posto solo.
// ---------------------------------------------------------------------------

enum StaffDocumentCategory {
  CONTRATTO
  CARTA_IDENTITA
  CODICE_FISCALE
  PERMESSO_SOGGIORNO
  CERTIFICAZIONE
  ATTESTATO
  CERTIFICATO_MEDICO
  BUSTA_PAGA
  ALTRO
}

model StaffDocument {
  id               String                @id @default(cuid())
  venueId          String
  waiterId         String
  category         StaffDocumentCategory @default(ALTRO)
  /// Il nome con cui si legge in elenco («Carta d'identità», «Busta paga
  /// agosto 2026»), diverso dal nome del file.
  name             String                @db.VarChar(160)
  /// Percorso interno nel Blob, mai un URL pubblico: si legge solo passando
  /// da /api/waiters/[id]/documents/[docId], che controlla sessione, locale e
  /// permesso — come ContractDocument.
  storageKey       String
  originalFileName String
  mimeType         String
  fileSize         Int
  expiresAt        DateTime?
  notes            String?               @db.VarChar(500)
  uploadedBy       String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  venue            Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)
  waiter           Waiter                @relation(fields: [waiterId], references: [id], onDelete: Cascade)
  training         StaffTraining?
  medicalCheck     StaffMedicalCheck?

  @@index([venueId, waiterId, createdAt])
  @@index([venueId, expiresAt])
}

enum StaffTrainingKind {
  SICUREZZA_LAVORO
  HACCP
  ANTINCENDIO
  PRIMO_SOCCORSO
  ALTRO
}

model StaffTraining {
  id                    String            @id @default(cuid())
  venueId               String
  waiterId              String
  kind                  StaffTrainingKind
  /// Il nome, quando `kind` è ALTRO o quando il corso ha un titolo suo.
  name                  String?           @db.VarChar(160)
  completedAt           DateTime?
  expiresAt             DateTime?
  provider              String?           @db.VarChar(160)
  certificateNumber     String?           @db.VarChar(80)
  notes                 String?           @db.VarChar(1000)
  certificateDocumentId String?           @unique
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  venue                 Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  waiter                Waiter            @relation(fields: [waiterId], references: [id], onDelete: Cascade)
  certificate           StaffDocument?    @relation(fields: [certificateDocumentId], references: [id], onDelete: SetNull)

  @@index([venueId, waiterId])
  @@index([venueId, expiresAt])
}

enum StaffMedicalFitness {
  IDONEO
  IDONEO_CON_LIMITAZIONI
  NON_IDONEO
  IN_ATTESA
}

model StaffMedicalCheck {
  id                    String              @id @default(cuid())
  venueId               String
  waiterId              String
  examinedAt            DateTime
  fitness               StaffMedicalFitness @default(IDONEO)
  expiresAt             DateTime?
  doctorName            String?             @db.VarChar(160)
  notes                 String?             @db.VarChar(1000)
  certificateDocumentId String?             @unique
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  venue                 Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  waiter                Waiter              @relation(fields: [waiterId], references: [id], onDelete: Cascade)
  certificate           StaffDocument?      @relation(fields: [certificateDocumentId], references: [id], onDelete: SetNull)

  @@index([venueId, waiterId, examinedAt])
  @@index([venueId, expiresAt])
}

model StaffNote {
  id           String   @id @default(cuid())
  venueId      String
  waiterId     String
  body         String   @db.VarChar(2000)
  /// Chi l'ha scritta, come si legge: nome o email al momento della nota.
  /// Denormalizzato di proposito — se l'account viene tolto, la nota resta
  /// firmata.
  authorUserId String?
  authorLabel  String   @db.VarChar(160)
  createdAt    DateTime @default(now())
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  waiter       Waiter   @relation(fields: [waiterId], references: [id], onDelete: Cascade)

  @@index([venueId, waiterId, createdAt])
}

// Cosa può fare una persona dentro il gestionale, voce per voce. Il ruolo
// (`StaffRole`) ne dà un preset; questa lista permette di scostarsene.
enum StaffPermission {
  VIEW_OWN_SHIFTS
  REQUEST_LEAVE
  VIEW_ANNOUNCEMENTS
  VIEW_BOOKINGS
  EDIT_BOOKINGS
  VIEW_FLOOR
  VIEW_GUESTS
  VIEW_REPORTS
  MANAGE_MENU
}

// Job title (what this person primarily is). Distinct from StaffCapability
// (what they're allowed to be assigned to do) — primaryRole only drives a
// default-fill suggestion for capabilities, never gates assignment on its own.
enum StaffPrimaryRole {
  RESTAURANT_MANAGER
  MAITRE
  CHEF_DE_RANG
  CAMERIERE
  COMMIS_SALA
  SOMMELIER
  HEAD_SOMMELIER
  RUNNER
  BUSSER
  HOST
  BARTENDER
  EXECUTIVE_CHEF
  SOUS_CHEF
  CHEF_DE_PARTIE
  COMMIS_CUCINA
  LAVAPIATTI
}

// Shared vocabulary for both "what a waiter can do" (Waiter.capabilities)
// and "what function a specific assignment fills" (StaffAssignment.assignmentType)
// — one enum instead of two parallel taxonomies that would drift apart.
enum StaffCapability {
  TABLE_RESPONSIBLE
  TABLE_SUPPORT
  SOMMELIER
  RUNNER
  BUSSER
  ROOM_SUPERVISOR
  SERVICE_MANAGER
  MAITRE
  HOST
  BARTENDER
}

enum AssignmentScope {
  SERVICE
  ROOM
  TABLE
}

model WaiterAssignment {
  id             String                @id @default(cuid())
  venueId        String
  waiterId       String
  date           DateTime
  service        String
  assignmentMode ServiceAssignmentMode
  roomId         String?
  tableIds       String[]              @default([])
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  venue          Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)
  waiter         Waiter                @relation(fields: [waiterId], references: [id], onDelete: Cascade)
  room           Room?                 @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([waiterId, date, service])
  @@index([venueId, date, service])
}

// Multi-scope staff assignment (service / room / table), role+capability
// model. Table-scoped rows are the only ones written in Phase 1; SERVICE and
// ROOM scopes are modeled now so a future phase can add them without a
// schema change. Superseding WaiterAssignment's table mode, which stays in
// place (deprecated, unused by new code) for rollback safety.
model StaffAssignment {
  id             String          @id @default(cuid())
  venueId        String
  waiterId       String
  date           DateTime
  service        String
  scope          AssignmentScope
  roomId         String?
  tableId        String?
  assignmentType StaffCapability
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  venue          Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  waiter         Waiter          @relation(fields: [waiterId], references: [id], onDelete: Cascade)
  room           Room?           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  table          Table?          @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, date, service, assignmentType], name: "StaffAssignment_table_slot")
  @@index([venueId, date, service, scope])
  @@index([waiterId, date, service])
}

// Chi lavora, quando. Il **turno**, che e' una cosa diversa dalle due che gia'
// esistono e che non vanno confuse:
//
//   Shift            = le fasce di apertura del locale (lun, 19:00-23:00, 80 coperti)
//   StaffAssignment  = **dove** sta una persona durante un servizio (sala B, tavoli T1-T7)
//   WorkShift        = **quando** lavora una persona (martedi' 18:00-00:00), o non lavora
//
// Un riposo e' una riga come le altre, con `kind` diverso e gli orari nulli:
// «non lavora» e' un fatto pianificato, e in un calendario deve occupare una
// casella, non essere un buco indistinguibile da «non ancora pianificato».
model WorkShift {
  id           String           @id @default(cuid())
  venueId      String
  waiterId     String
  /// Il giorno, a mezzanotte UTC. Solo data: l'orario sta nei minuti sotto.
  date         DateTime         @db.Date
  kind         WorkShiftKind    @default(WORK)
  /// Minuti da mezzanotte, come `Shift.startMinute`. Non un DateTime, e il
  /// motivo e' il turno serale: 18:00-00:00 si scrive 1080-1440, e 1440 e'
  /// «mezzanotte di domani» senza doverci ragionare. Con due DateTime lo
  /// stesso turno avrebbe la fine su un giorno diverso dall'inizio, e ogni
  /// query sulla settimana dovrebbe saperlo. Nulli quando `kind` non e' WORK.
  startMinute  Int?
  endMinute    Int?
  breakMinutes Int?
  /// Il reparto in cui si lavora **questo** turno. Nullo = quello della
  /// persona: serve solo quando un commis di sala copre una sera al bar.
  department   StaffDepartment?
  /// Il servizio, dallo stesso vocabolario di `listServiceOptions()` —
  /// «Pranzo», «Cena». Testo e non enum perche' quelle etichette le decide il
  /// locale nelle sue fasce, e un enum qui si disallineerebbe al primo
  /// «Aperitivo».
  service      String?
  notes        String?          @db.VarChar(500)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  venue        Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  waiter       Waiter           @relation(fields: [waiterId], references: [id], onDelete: Cascade)
  requests     StaffRequest[]

  @@index([venueId, date])
  @@index([waiterId, date])
}

enum WorkShiftKind {
  WORK
  REST
  VACATION
  LEAVE
  SICK_LEAVE
  UNAVAILABLE
}

// La richiesta di un dipendente, e la sua approvazione.
//
// La regola che giustifica una tabella a se' invece di due colonne su
// WorkShift: **il turno non cambia finche' qualcuno non approva**. Una
// richiesta pendente non deve toccare il calendario, altrimenti il
// responsabile legge una settimana che nessuno ha deciso. Qui la richiesta
// vive accanto al turno, e solo l'approvazione lo riscrive.
model StaffRequest {
  id                   String             @id @default(cuid())
  venueId              String
  waiterId             String
  /// Il turno a cui si riferisce, quando ce n'e' uno. Nullo per una ferie
  /// chiesta su giorni non ancora pianificati.
  shiftId              String?
  type                 StaffRequestType
  /// Cosa si chiede. Un intervallo di giorni per le ferie, un giorno solo per
  /// il cambio turno; gli orari sono valorizzati solo su SHIFT_CHANGE.
  requestedFrom        DateTime?          @db.Date
  requestedTo          DateTime?          @db.Date
  requestedStartMinute Int?
  requestedEndMinute   Int?
  reason               String?            @db.VarChar(1000)
  status               StaffRequestStatus @default(PENDING)
  reviewedByUserId     String?
  reviewedAt           DateTime?
  reviewNote           String?            @db.VarChar(1000)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  venue                Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  waiter               Waiter             @relation(fields: [waiterId], references: [id], onDelete: Cascade)
  shift                WorkShift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  reviewedBy           User?              @relation("StaffRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([venueId, status, createdAt])
  @@index([waiterId, createdAt])
}

enum StaffRequestType {
  SHIFT_CHANGE
  DAY_OFF
  VACATION
  LEAVE
  UNAVAILABILITY
}

enum StaffRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

// Modello morto: nessun riferimento in tutto src/ ne' negli script. Era un
// abbozzo di costo del lavoro (nome scritto a mano, ore, paga oraria) mai
// collegato a niente. Non e' il turno di WorkShift, che e' qui sopra. Resta in
// piedi solo perche' toglierlo e' una migrazione distruttiva, e quelle
// bloccano le migrazioni in attesa sulle anteprime (vedi scripts/migrate-safe.ts).
model StaffShift {
  id          String   @id @default(cuid())
  venueId     String
  staffName   String

model Payment {
  id                      String              @id @default(cuid())
  venueId                 String
  bookingId               String?
  guestId                 String?
  /// Il conto al tavolo che questo pagamento salda, in tutto o in parte.
  ///
  /// Un conto ha molti pagamenti — è il punto dell'intera funzione: sei
  /// persone a tavola sono sei pagamenti sullo stesso `Order`. Quanto è stato
  /// pagato e quanto resta **non stanno in colonna**: si sommano da qui. Un
  /// totale copiato accanto alle righe che lo compongono è un totale che
  /// prima o poi le contraddice, e qui contraddirlo significa incassare due
  /// volte la stessa cena o non incassarla affatto.
  orderId                 String?
  /// Il tavolo da cui è partito. Il conto conosce già la prenotazione, ma non
  /// il tavolo come riga: `Order.tableLabel` è una stringa, e una stringa non
  /// risponde a «quanto incassa il tavolo 12».
  tableId                 String?
  /// Il totale della transazione: quello che il cliente vede addebitato, ed è
  /// **conto + mancia**.
  amountCents             Int
  /// Quanto di quel totale è mancia.
  ///
  /// Il conto si ricava per differenza — `amountCents - tipCents` — invece di
  /// stare in una terza colonna. Tre numeri di cui uno è la somma degli altri
  /// due sono un'occasione di scriverne uno sbagliato: il giorno in cui
  /// `billCents + tipCents != amountCents`, nessuno saprebbe quale dei tre
  /// credere, e la risposta cambierebbe il residuo del tavolo.
  tipCents                Int                 @default(0)
  currency                String              @default("EUR")
  kind                    PaymentKind         @default(DEPOSIT)
  status                  PaymentStatus       @default(PENDING)
  stripePaymentId         String?
  /// La sessione di pagamento di Stripe. È unica perché è la chiave con cui
  /// si ritrova il pagamento quando arriva il webhook, ed è il motivo per cui
  /// lo stesso evento consegnato due volte non incassa due volte.
  stripeCheckoutSessionId String?             @unique
  /// Come ha pagato, come lo racconta Stripe: `card`, `apple_pay`, `link`.
  /// Serve al locale per riconciliare col proprio estratto conto.
  paymentMethod           String?             @db.VarChar(40)
  /// L'indirizzo che il cliente ha lasciato per la ricevuta, se l'ha lasciato.
  /// È facoltativo di proposito: chiedere un'email per poter pagare il conto
  /// che si è già consumato sarebbe raccogliere contatti con la leva
  /// sbagliata.
  customerEmail           String?             @db.VarChar(200)
  /// Quando il denaro è stato confermato **da Stripe**. Diverso da
  /// `createdAt`, che è quando il cliente ha premuto «paga»: fra i due c'è il
  /// tempo in cui il pagamento poteva ancora fallire.
  paidAt                  DateTime?
  failedAt                DateTime?
  /// Fino a quando questo tentativo tiene impegnato il residuo del conto.
  ///
  /// Un pagamento avviato e mai concluso — il cliente chiude la pagina di
  /// Stripe, o il telefono muore — bloccherebbe per sempre la sua parte di
  /// conto, e gli altri commensali resterebbero davanti a un residuo che non
  /// possono pagare. Scaduto, quanto era impegnato torna disponibile.
  expiresAt               DateTime?
  /// Quanto è già stato restituito, in centesimi: un rimborso parziale non è
  /// un rimborso, e segnare solo `REFUNDED` cancellerebbe dall'incasso anche
  /// la parte che il locale ha tenuto.
  refundedCents           Int                 @default(0)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @default(now()) @updatedAt
  refundedAt              DateTime?
  deletedAt               DateTime?
  deletedBy               String?
  fxAmountBaseCents       Int?
  fxBaseCurrency          String?             @db.VarChar(3)
  fxRateToBase            Decimal?            @db.Decimal(12, 6)
  booking                 Booking?            @relation(fields: [bookingId], references: [id])
  guest                   Guest?              @relation(fields: [guestId], references: [id])
  venue                   Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  order                   Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  table                   Table?              @relation(fields: [tableId], references: [id], onDelete: SetNull)
  allocations             PaymentAllocation[]

  @@index([venueId, createdAt])
  @@index([venueId, deletedAt])
  /// L'indice che regge il calcolo del residuo: «tutti i pagamenti di questo
  /// conto, per stato». Lo si interroga a ogni apertura della pagina pubblica
  /// e dentro ogni transazione che incassa.
  @@index([orderId, status])
  @@index([tableId, createdAt])
}

/// Un pezzo di conto **impegnato** da un tentativo di pagamento.
///
/// Esiste per una scena precisa: due persone allo stesso tavolo selezionano
/// entrambe la stessa bottiglia e premono «paga» a pochi secondi di distanza.
/// Senza una riga che dica «questa unità è già di qualcuno», Stripe incassa
/// due volte lo stesso Barolo — e il locale se ne accorge dal reclamo.
///
/// La quantità è per **unità**, non per riga: tre calici su una riga sola
/// devono poter essere pagati da tre persone diverse, che è il motivo per cui
/// qui c'è `quantity` e non un semplice legame all'`OrderItem`.
///
/// Le prenotazioni scadono da sole (vedi `Payment.expiresAt`): un impegno che
/// non si libera mai è peggio di nessun impegno, perché blocca il tavolo
/// invece di proteggerlo.
model PaymentAllocation {
  id          String           @id @default(cuid())
  paymentId   String
  orderId     String
  orderItemId String
  /// Quante unità di quella riga: 1 dei 3 calici.
  quantity    Int
  /// Quanto valgono quelle unità, fotografato adesso. Se il cameriere corregge
  /// il prezzo della riga mentre il cliente è sulla pagina di Stripe, si
  /// incassa quello che gli è stato mostrato.
  amountCents Int
  status      AllocationStatus @default(RESERVED)
  createdAt   DateTime         @default(now())
  payment     Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /// «Quante unità di questa riga sono già prese»: la domanda di ogni
  /// apertura della pagina e di ogni tentativo di pagamento.
  @@index([orderItemId, status])
  @@index([orderId, status])
  @@index([paymentId])
}

enum AllocationStatus {
  /// Impegnata da un pagamento in corso, non ancora incassata.
  RESERVED
  /// Pagata: da qui non torna più indietro se non con un rimborso.
  PAID
  /// Liberata perché il pagamento è stato abbandonato o è fallito.
  RELEASED
  /// Liberata perché nessuno l'ha conclusa in tempo.
  EXPIRED
}


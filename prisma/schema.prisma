generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String              @id @default(cuid())
  email                  String              @unique
  name                   String?
  passwordHash           String?
  image                  String?
  createdAt              DateTime            @default(now())
  /// Istante da cui le sessioni **emesse prima** non valgono più.
  ///
  /// Le sessioni sono token firmati, non righe: non si possono cancellare una
  /// per una. Questa colonna è la revoca — si scrive «adesso» e tutti i token
  /// emessi prima di adesso, su qualunque dispositivo, smettono di funzionare
  /// al primo controllo. Serve nei due momenti in cui serve davvero: un
  /// tablet perso in sala, e una persona che non lavora più qui.
  sessionsRevokedAt      DateTime?
  totpEnabled            Boolean             @default(false)
  totpSecret             String?
  recoveryCodesHash      String[]            @default([])
  /// L'ultimo accesso riuscito. Si scrive in `authorize` (lib/auth.ts), una
  /// volta per login, non a ogni richiesta: serve alla scheda del dipendente
  /// per dire «è entrato ieri sera», non a misurare l'attività.
  lastLoginAt            DateTime?
  /// Il link per reimpostare la password, quando un responsabile ne ha
  /// generato uno. Si conserva l'hash e non il token: chi legge il database
  /// non deve poter entrare al posto di qualcuno. Vale una volta e scade.
  passwordResetHash      String?             @unique
  passwordResetExpiresAt DateTime?
  sessions               Session[]
  orgMemberships         OrgMembership[]
  venueMemberships       VenueMembership[]
  agentConversations     AgentConversation[]
  /// I profili di personale collegati a questo account, uno per locale.
  ///
  /// Nullo su quasi tutti i `Waiter` di oggi: si popola solo quando la
  /// persona riceve davvero un accesso. Un profilo senza account resta un
  /// profilo pieno — il lavapiatti che non usa il gestionale esiste lo
  /// stesso in organico.
  staffProfiles          Waiter[]
  reviewedRequests       StaffRequest[]      @relation("StaffRequestReviewer")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  plan         Plan            @default(STARTER)
  createdAt    DateTime        @default(now())
  baseCurrency String          @default("EUR")
  AuditLog     AuditLog[]
  venues       Venue[]
  members      OrgMembership[]
}

model OrgMembership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      OrgRole      @default(OWNER)
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@map("org_membership")
}

model Venue {
  id                     String    @id @default(cuid())
  orgId                  String
  name                   String
  slug                   String
  kind                   VenueKind @default(RESTAURANT)
  timezone               String    @default("Europe/Rome")
  /// Quanti punti fedeltà per ogni euro speso. Nullo = raccolta punti spenta.
  ///
  /// Sta qui e non in una costante perché è una decisione commerciale del
  /// locale, e perché una raccolta punti accesa da sola — senza che nessuno
  /// abbia deciso quanto vale un punto — regalerebbe sconti a caso.
  loyaltyPointsPerEuro   Int?
  /// Quanto vale un punto quando si riscatta, in centesimi. Nullo = spenta.
  loyaltyPointValueCents Int?
  /// Il traguardo: quanti punti servono per il premio, e cos'è il premio.
  ///
  /// Uno sconto lineare («100 punti = 5 €») non fa tornare nessuno: è troppo
  /// piccolo per essere notato. Un traguardo sì — «ti mancano 40 punti alla
  /// cena omaggio» è la frase che riporta le persone. Nulli = nessun premio,
  /// e i punti restano solo uno sconto.
  loyaltyRewardPoints    Int?
  loyaltyRewardLabel     String?   @db.VarChar(120)
  /// Quanti giorni prima si può prenotare online. Nullo = nessun limite.
  bookingWindowDays      Int?
  /// Quanti minuti prima dell'orario si chiude la prenotazione online. Nullo = fino all'ultimo.
  bookingCutoffMin       Int?
  /// Quanti coperti oltre la capienza del turno il locale accetta, in percentuale. Nullo = nessuno.
  overbookingPct         Int?
  /// Spesa media per coperto, in centesimi, dichiarata dal locale.
  /// Serve per la stima degli incassi: prima veniva calcolata dalla media di
  /// Guest.totalSpend, un campo che nessuna parte del codice aggiorna — quindi
  /// la stima era finzione presentata come dato.
  avgSpendCents          Int?
  currency               String    @default("EUR")
  address                String?
  city                   String?
  country                String?
  phone                  String?
  email                  String?
  coverImage             String?
  active                 Boolean   @default(true)
  createdAt              DateTime  @default(now())
  depositPerPersonCents  Int       @default(2000)
  depositThreshold       Int       @default(8)
  wifiAutoCouponDays     Int       @default(30)
  wifiAutoCouponEnabled  Boolean   @default(false)
  wifiAutoCouponPercent  Int       @default(10)
  wifiPortalAccent       String?   @db.VarChar(9)
  wifiPortalLegal        String?   @db.VarChar(2000)
  wifiPortalLogoUrl      String?
  wifiPortalWelcome      String?   @db.VarChar(500)
  wifiSetupAt            DateTime?
  /// Quali recapiti chiede il modulo pubblico, oltre al nome — che serve
  /// sempre: senza un nome, un contatto non è una persona.
  ///
  /// Sono due interruttori e non un elenco di campi liberi: ogni campo in più
  /// è una persona in meno che arriva in fondo, e il locale deve poter
  /// chiedere solo ciò che usa davvero. Almeno uno dei due resta acceso —
  /// un modulo che non chiede nessun recapito raccoglie nomi inutilizzabili.
  wifiAskEmail           Boolean   @default(true)
  wifiAskPhone           Boolean   @default(true)
  /// La spunta facoltativa del marketing sul portale. Spenta, il portale
  /// smette di chiederla: meglio non avere un consenso che raccoglierlo senza
  /// sapere cosa farsene.
  wifiAskMarketing       Boolean   @default(true)
  /// Quando il locale ha **dichiarato** di aver collegato il portale al
  /// proprio router.
  ///
  /// Non è un rilevamento: dal router non arriva nessun segnale, e fingere di
  /// saperlo sarebbe uno di quegli stati inventati che questo prodotto ha
  /// passato giorni a togliere. È la spunta di chi c'era, con la data, e si
  /// può togliere.
  wifiRouterConfirmedAt  DateTime?
  /// Il nome della rete e la password che il cliente riceve dopo aver
  /// lasciato il contatto.
  ///
  /// Servono perché il portale funzioni **davvero**: Tavolo non apre la rete —
  /// quello lo fa il router — e senza una password da mostrare la pagina
  /// raccoglierebbe un indirizzo email senza dare niente in cambio. È la
  /// password della rete ospiti, cioè una cosa nata per essere data a
  /// chiunque entri nel locale.
  wifiNetworkName        String?   @db.VarChar(64)
  /// La password della rete, **cifrata a riposo** (AES-256-GCM, vedi
  /// `lib/cifratura`). Non è un'impronta: va riletta e mostrata a chi lascia
  /// un contatto, ed è il motivo per cui il portale esiste.
  ///
  /// Era `VarChar(128)`, che il testo cifrato non rispetta: una passphrase da
  /// 128 caratteri, col vettore d'inizializzazione e il sigillo, arriva a
  /// oltre duecento. È `text` e non un `VarChar` più larga perché diventare
  /// `text` è l'unico cambio di tipo che non può restringere niente — e il
  /// freno delle migrazioni lo sa (vedi `lib/migration-safety`).
  /// Da quante persone una prenotazione online diventa una telefonata.
  ///
  /// Era una costante nel modulo pubblico (dodici), e dodici va bene per una
  /// trattoria e non per una sala che fa banchetti: il punto in cui una
  /// prenotazione «diventa un'organizzazione» lo sa il locale, non noi.
  largePartyFrom         Int       @default(12)

  wifiPassword          String?
  /// Dove mandare la persona dopo: il sito del locale, la carta, oppure
  /// l'indirizzo con cui il router del locale sblocca la navigazione.
  wifiRedirectUrl       String?
  calendarToken         String?               @unique
  googlePlaceId         String?
  brevoFolderId         Int?
  brandAccent           String?               @db.VarChar(9)
  brandFootnote         String?               @db.VarChar(280)
  brandLogoUrl          String?
  brandSecondaryColor   String?               @db.VarChar(9)
  brandBackgroundColor  String?               @db.VarChar(9)
  brandTypography       BrandTypography?
  websiteUrl            String?
  instagramUrl          String?
  facebookUrl           String?
  googleBusinessUrl     String?
  onboardingStatus      BrandOnboardingStatus @default(NOT_STARTED)
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?
  serviceAssignmentMode ServiceAssignmentMode @default(ROOMS)

  // --- Pagamento al tavolo col QR (vedi server/pagamenti-tavolo.ts) ---

  /// L'account Stripe **del ristorante**, non di Tavolo.
  ///
  /// Gli incassi di una cena sono del locale che l'ha servita: farli arrivare
  /// sull'account della piattaforma renderebbe Tavolo l'incassante legale di
  /// ogni coperto dei suoi clienti, con tutto quello che ne segue in fatto di
  /// antiriciclaggio e fiscalità. Quindi Connect, e gli addebiti nascono
  /// direttamente sull'account del locale.
  ///
  /// Qui sta **solo** questo identificativo (`acct_...`), che non è un
  /// segreto: le chiavi del ristorante non passano mai da Tavolo e non
  /// esistono in questo database, in chiaro o cifrate.
  stripeAccountId      String?
  /// Se Stripe ha finito di verificare il locale e accetta incassi. Lo dice
  /// Stripe, non noi: si aggiorna dal webhook `account.updated`. Un
  /// `stripeAccountId` presente non basta — un onboarding lasciato a metà
  /// produce un account che esiste e rifiuta ogni pagamento.
  stripeChargesEnabled Boolean   @default(false)
  stripePayoutsEnabled Boolean   @default(false)
  stripeOnboardedAt    DateTime?
  /// L'interruttore generale del pagamento al tavolo per questo locale.
  qrPaymentsEnabled    Boolean   @default(false)
  /// Se chiedere la mancia prima di pagare. In Italia non è scontato volerla
  /// chiedere, e un locale che la trova fuori luogo deve poterla spegnere
  /// senza rinunciare al resto.
  tipsEnabled          Boolean   @default(true)
  /// Le percentuali proposte, in ordine. Vuoto = solo «importo mio».
  tipPresets           Int[]     @default([5, 10, 15])
  /// Il minimo che ha senso incassare con carta: sotto questa cifra la
  /// commissione si mangia il pagamento. In centesimi.
  minPaymentCents      Int       @default(100)

  /// La chiave che accende il centralino in questo locale.
  ///
  /// La emette miocentralino, firmata; qui si conserva **per intero** perché
  /// va riverificata a ogni lettura: se conservassimo solo «acceso: sì», una
  /// riga cambiata a mano nel database darebbe il centralino a chi non l'ha
  /// comprato. La firma è la prova, e la prova va tenuta.
  phoneLicenseKey         String?
  /// Quando è stata inserita. Nullo = il centralino non è mai stato acceso qui.
  phoneLicenseActivatedAt DateTime?
  /// L'ultimo istante di validità, copiato dalla chiave per poterlo mostrare
  /// e filtrare senza rileggere la firma a ogni schermata.
  phoneLicenseExpiresAt   DateTime?
  /// Le funzioni accese da questa chiave. Copiate dalla chiave per lo stesso
  /// motivo: leggerle costa una colonna, non una verifica.
  phoneLicenseFeatures    String[]  @default([])

  agentConversations AgentConversation[]
  agentUsages        AgentUsage[]
  ApiToken           ApiToken[]
  AutomationWorkflow AutomationWorkflow[]
  BackgroundJob      BackgroundJob[]
  bookings           Booking[]
  CallLog            CallLog[]
  campaigns          Campaign[]
  ChatSession        ChatSession[]
  Connector          Connector[]
  ConsentLog         ConsentLog[]
  CostEntry          CostEntry[]
  Coupon             Coupon[]
  CouponRedemption   CouponRedemption[]
  experiences        Experience[]
  FloorDecor         FloorDecor[]
  GiftCard           GiftCard[]
  guests             Guest[]
  GuestProviderLink  GuestProviderLink[]
  MenuCategory       MenuCategory[]
  MenuItem           MenuItem[]
  MenuItemCost       MenuItemCost[]
  MenuScan           MenuScan[]
  MessageLog         MessageLog[]
  MessageTemplate    MessageTemplate[]
  MissedCall         MissedCall[]
  Notification       Notification[]
  Order              Order[]
  POSConnector       POSConnector[]
  payments           Payment[]
  QrCode             QrCode[]
  Review             Review[]
  ReviewLink         ReviewLink[]
  ReviewLinkClick    ReviewLinkClick[]
  rooms              Room[]
  shifts             Shift[]
  StaffShift         StaffShift[]
  Survey             Survey[]
  tables             Table[]
  blocks             TableBlock[]
  org                Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  WaitlistEntry      WaitlistEntry[]
  WifiLead           WifiLead[]
  WifiSession        WifiSession[]
  members            VenueMembership[]
  invites            VenueInvite[]
  waiters            Waiter[]
  waiterAssignments  WaiterAssignment[]
  staffAssignments   StaffAssignment[]
  workShifts         WorkShift[]
  staffRequests      StaffRequest[]
  staffContracts     StaffContract[]
  contractDocuments  ContractDocument[]
  staffDocuments     StaffDocument[]
  staffTrainings     StaffTraining[]
  staffMedicalChecks StaffMedicalCheck[]
  staffNotes         StaffNote[]
  demSubscription    DemSubscription?
  demUsagePeriods    DemUsagePeriod[]
  demSuppressions    DemSuppression[]
  demDomain          DemDomain?
  demSesTenant       DemSesTenant?
  campaignRecipients CampaignRecipient[]
  campaignEvents     CampaignEvent[]
  comande            Comanda[]

  @@unique([orgId, slug])
}

/// Un invito a entrare nel team di un locale.
///
/// Esiste perché `VenueMembership` la scriveva solo il seed: i cinque ruoli
/// funzionavano e non c'era modo di assegnarli, quindi un ristorante non
/// poteva dare l'accesso al suo maître.
///
/// Il link si consegna a mano — si copia e si manda su WhatsApp, o si legge a
/// voce a chi è nella stanza accanto — perché l'email di Tavolo è spenta e una
/// funzione che dipende da una chiave che non c'è è una funzione che non c'è.
model VenueInvite {
  id         String    @id @default(cuid())
  venueId    String
  /// A chi è destinato: accettando, l'accesso nasce con questo indirizzo.
  email      String
  role       StaffRole @default(RECEPTION)
  /// Segreto del link. Unico e imprevedibile: è l'unica prova che serve.
  token      String    @unique
  expiresAt  DateTime
  /// Quando è stato usato. Un invito vale **una volta**.
  acceptedAt DateTime?
  /// Chi l'ha creato, per il registro.
  invitedBy  String?
  createdAt  DateTime  @default(now())
  venue      Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, acceptedAt])
}

model VenueMembership {
  id                String            @id @default(cuid())
  userId            String
  venueId           String
  role              StaffRole         @default(RECEPTION)
  /// I permessi nel gestionale, uno per uno. Vuoto finché `customPermissions`
  /// è falso: allora valgono quelli predefiniti del ruolo
  /// (`PERMESSI_PREDEFINITI` in lib/scheda-dipendente.ts). Quando un
  /// responsabile ne cambia anche uno solo, l'elenco intero si scrive qui e
  /// il ruolo smette di decidere.
  permissions       StaffPermission[] @default([])
  customPermissions Boolean           @default(false)
  /// Account disattivato per questo locale. Non si cancella la riga — la
  /// persona può tornare, e la storia di chi ha fatto cosa deve restare —
  /// ma `resolveActiveVenue` non la considera più: non entra.
  disabledAt        DateTime?
  createdAt         DateTime          @default(now())
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue             Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@map("venue_membership")
}

model Room {
  id                  String             @id @default(cuid())
  venueId             String
  name                String
  width               Int                @default(1200)
  height              Int                @default(800)
  ordering            Int                @default(0)
  floorPlanUrl        String?
  activeLayoutMode    RoomLayoutMode?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  FloorDecor          FloorDecor[]
  venue               Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tables              Table[]
  waiterAssignments   WaiterAssignment[]
  staffAssignments    StaffAssignment[]
  roomLayout          RoomLayout?
  waitlistPreferences WaitlistEntry[]

  @@index([venueId, ordering])
}

// Structured "Crea la tua sala" builder layout — additive/optional alongside
// the pre-existing image-upload flow (Room.floorPlanUrl). A Room can have
// both; Room.activeLayoutMode says which one is currently rendered, so
// switching modes never destroys the other's data (see floor-plan upload).
model RoomLayout {
  id             String    @id @default(cuid())
  roomId         String    @unique
  room           Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  unit           String    @default("m")
  pixelsPerMeter Int       @default(100)
  elements       Json      @default("[]")
  /// Quali livelli sono accesi sulla piantina (tavoli, struttura, aree,
  /// testi, immagine originale). Sta sulla sala e non sull'utente: chi apre
  /// la Sala deve trovare la piantina come l'ha lasciata il collega.
  layers         Json      @default("{}")
  /// Quanti tavoli il locale dichiara di possedere, per forma. La libreria
  /// dell'editor ne sottrae quelli già posizionati e mostra la disponibilità
  /// residua.
  inventory      Json      @default("{}")
  /// Nome, superficie e dimensioni quando non si ricavano dalla geometria e
  /// il locale li scrive a mano.
  meta           Json      @default("{}")
  /// Il risultato grezzo del riconoscimento della planimetria, conservato
  /// accanto agli elementi che ne sono derivati: se domani il riconoscimento
  /// migliora si rigenera senza richiedere di ricaricare l'immagine.
  analysis       Json?
  analyzedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Table {
  id               String            @id @default(cuid())
  venueId          String
  roomId           String?
  label            String
  seats            Int               @default(2)
  shape            TableShape        @default(ROUND)
  posX             Int               @default(0)
  posY             Int               @default(0)
  rotation         Int               @default(0)
  combinable       Boolean           @default(true)
  active           Boolean           @default(true)
  height           Int?
  width            Int?
  /// Il segreto stampato sull'adesivo del tavolo: chi lo inquadra apre il
  /// proprio conto senza registrarsi.
  ///
  /// Non è l'identificativo del tavolo e non gli assomiglia. Un `cuid()` in
  /// un URL pubblico si può provare a indovinare e soprattutto si può
  /// **confrontare**: due QR di due tavoli vicini mostrerebbero due stringhe
  /// che si somigliano, e da lì si arriva a leggere il conto del tavolo
  /// accanto. Sono 32 caratteri da un generatore crittografico, vedi
  /// `lib/pay-token.ts`.
  ///
  /// È nullo finché il locale non accende il pagamento al tavolo: un segreto
  /// generato per ogni tavolo di ogni locale, compresi quelli che non useranno
  /// mai questa funzione, è superficie d'attacco creata per niente.
  payQrToken       String?           @unique
  /// Se questo tavolo accetta pagamenti dal QR. Spento, il link risponde
  /// «non attivo» invece di 404: il QR resta incollato al tavolo anche quando
  /// il locale sospende la funzione, e chi lo inquadra merita una frase, non
  /// una pagina d'errore.
  payQrEnabled     Boolean           @default(false)
  /// Quando il segreto è stato rigenerato l'ultima volta. Serve a rispondere
  /// «da quando il vecchio adesivo non funziona più».
  payQrRotatedAt   DateTime?
  /// L'ultima volta che qualcuno ha inquadrato **questo** QR. È la sola prova
  /// che l'adesivo sul tavolo è ancora leggibile e attaccato dov'era.
  payQrLastSeenAt  DateTime?
  bookings         Booking[]
  room             Room?             @relation(fields: [roomId], references: [id], onDelete: Restrict)
  venue            Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  blocks           TableBlock[]
  staffAssignments StaffAssignment[]
  payments         Payment[]
  qrCodes          QrCode[]
  comande          Comanda[]

  @@unique([venueId, label])
}

model TableBlock {
  id       String   @id @default(cuid())
  venueId  String
  tableId  String
  startsAt DateTime
  endsAt   DateTime
  reason   String?
  table    Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([tableId, startsAt, endsAt])
}

model Shift {
  id          String  @id @default(cuid())
  venueId     String
  name        String
  weekday     Int
  startMinute Int
  endMinute   Int
  capacity    Int     @default(80)
  slotMinutes Int     @default(15)
  active      Boolean @default(true)
  venue       Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, weekday, active])
}

model Guest {
  id                     String               @id @default(cuid())
  venueId                String
  firstName              String
  lastName               String?
  email                  String?
  phone                  String?
  birthday               DateTime?
  language               String               @default("it")
  loyaltyTier            LoyaltyTier          @default(NEW)
  totalVisits            Int                  @default(0)
  totalSpend             Decimal              @default(0) @db.Decimal(12, 2)
  noShowCount            Int                  @default(0)
  lastVisitAt            DateTime?
  preferences            Json?
  allergies              String?
  privateNotes           String?
  tags                   String[]             @default([])
  marketingOptIn         Boolean              @default(false)
  /// Quando e da dove è arrivato il consenso.
  ///
  /// `marketingOptIn` da solo dice «sì» e non dice quando né perché: davanti a
  /// una contestazione è una casella spuntata da nessuno. `ConsentLog` conserva
  /// la storia completa; queste due colonne sono l'ultimo stato, perché
  /// filtrare un segmento non può voler dire leggere il registro di ogni
  /// cliente.
  marketingConsentAt     DateTime?
  /// `wifi`, `prenotazione`, `import`, `manuale`, `widget`.
  marketingConsentSource String?              @db.VarChar(40)
  /// Quando si è disiscritto. La scheda resta — un cliente disiscritto è
  /// sempre un cliente — e il CRM continua a mostrarla: cambia solo che non
  /// riceve più campagne.
  unsubscribedAt         DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  blocked                Boolean              @default(false)
  blockedAt              DateTime?
  blockedReason          String?              @db.VarChar(400)
  loyaltyPoints          Int                  @default(0)
  /// Il numero della tessera: l'unico identificativo di questo cliente che è
  /// fatto per **uscire dal database** — stamparlo su una card, metterlo in un
  /// QR, dettarlo al telefono.
  ///
  /// Serviva perché non ce n'era nessuno. L'unica chiave era il `cuid`, che è
  /// un identificatore interno: metterlo in un codice a barre significa dare
  /// al cliente la chiave primaria di una riga, e poi non poterla più cambiare.
  ///
  /// Nullo finché non serve: si assegna la prima volta che qualcuno apre la
  /// scheda o crea l'ospite (`lib/tessera.ts`), non a tutti in blocco. Un
  /// codice generato per chi non lo userà mai è solo un numero in più da
  /// mantenere unico.
  loyaltyCardCode        String?              @unique
  anonymizedAt           DateTime?
  anonymizedBy           String?
  bookings               Booking[]
  ConsentLog             ConsentLog[]
  Coupon                 Coupon[]
  CouponRedemption       CouponRedemption[]
  venue                  Venue                @relation(fields: [venueId], references: [id], onDelete: Cascade)
  GuestProviderLink      GuestProviderLink[]
  LoyaltyTransaction     LoyaltyTransaction[]
  MessageLog             MessageLog[]
  Order                  Order[]
  payments               Payment[]
  WifiLead               WifiLead[]
